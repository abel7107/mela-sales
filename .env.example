NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://mela:mela_password@localhost:3306/mela_sales"
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=8
# local = built-in email/password (Argon2id); mela = Mela Auth tokens only; both = either
AUTH_MODE=local
ALLOW_REGISTRATION=true
# Mela Auth token verification (HS256 secret OR RS256/ES256 public key PEM)
MELA_AUTH_JWT_SECRET=
MELA_AUTH_JWT_PUBLIC_KEY=
MELA_AUTH_ISSUER=
MELA_AUTH_AUDIENCE=
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
TRUST_PROXY=false
UPLOAD_DIR=./uploads
# Path to a .ttf with Ethiopic glyphs (e.g. Noto Sans Ethiopic, OFL) for Amharic invoices
INVOICE_FONT_PATH=
# Africa/Addis_Ababa is UTC+3 with no DST
BUSINESS_TZ_OFFSET_MINUTES=180
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=300
# docker compose only
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=mela_password
