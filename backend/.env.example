# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# Leave empty to allow all origins (development only).
CORS_ORIGINS=http://localhost:5173

# Requests allowed per minute per IP (ignored when NODE_ENV=test).
RATE_LIMIT_PER_MINUTE=300

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=mela_sales_db

# Mela Auth (OpenID Connect style JWT verification)
MELA_AUTH_ISSUER=https://auth.example.com/
MELA_AUTH_AUDIENCE=mela-sales-api
MELA_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
