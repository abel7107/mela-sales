NODE_ENV=production
PORT=5000
CORS_ORIGINS=https://your-frontend-domain.example
RATE_LIMIT_PER_MINUTE=300

DB_HOST=your-db-host
DB_PORT=3306
DB_USER=mela_sales_app
DB_PASSWORD=change-me
DB_NAME=mela_sales_db

MELA_AUTH_ISSUER=https://your-auth.example/
MELA_AUTH_AUDIENCE=mela-sales-api
MELA_AUTH_JWKS_URL=https://your-auth.example/.well-known/jwks.json
MELA_AUTH_PRIVATE_KEY_PATH=/app/data/auth-signing-key.pem
